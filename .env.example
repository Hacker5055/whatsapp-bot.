# الهوية والصلاحيات
BOT_NAME=Black X
OWNER_NAME=مالك البوت
# رقم دولي بدون + أو أصفار دولية إضافية. مثال توضيحي فقط.
OWNER_NUMBER=
BOT_MODE=private
STICKER_PACK=Black X
STICKER_AUTHOR=بلاك إكس
REPOSITORY_URL=https://github.com/Hacker5055/whatsapp-bot.

# الربط المحلي: اتركه فارغًا لعرض QR، أو مرر الرقم لأمر npm run pair.
PAIRING_NUMBER=
LOG_LEVEL=silent
WARN_COUNT=3

#.heroku يرسل DATABASE_URL تلقائيًا عند إضافة PostgreSQL.
# لا تضع رابط قاعدة بيانات حقيقي في هذا الملف بعد نسخه إلى Git.
DATABASE_URL=
# 32 بايت base64 أو 64 حرف hex. أنشئ مفتاحًا بـ npm run session:key.
SESSION_ENCRYPTION_KEY=
SESSION_ID=black-x
# Heroku PostgreSQL يستخدم شهادة لا يتحقق منها عميل pg افتراضيًا.
# اترك DATABASE_SSL_REJECT_UNAUTHORIZED=false على Heroku.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# للاختبار المحلي غير المشفر فقط: DATABASE_SSL=false

# اختياري: فعّل الخدمات بمفاتيح حسابك، لا تستخدم مفاتيح مطورين آخرين.
OPENWEATHER_API_KEY=
NEWS_API_KEY=
NEWS_COUNTRY=eg
GIPHY_API_KEY=
# خدمات الوسائط الموروثة. قد تحتاج اشتراكًا أو مفتاحًا خاصًا.
MEDIA_API_URL=https://knightbotapi.stream
MEDIA_API_KEY=
PRINCE_API_URL=https://api.princetechn.com
PRINCE_API_KEY=
